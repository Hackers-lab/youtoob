{
  "version": 2,
  "functions": {
    "api/alexa.js": {
      "memory": 1024,
      "maxDuration": 15
    },
    "api/debug.js": {
      "memory": 1024,
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/alexa.js"
    },
    {
      "source": "/api/alexa",
      "destination": "/api/alexa.js"
    },
    {
      "source": "/api/debug",
      "destination": "/api/debug.js"
    }
  ]
}